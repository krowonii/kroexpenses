# Supabase — fill in from your project's dashboard:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI (Gemini) API key — powers AI expense categorization.
# Create one at https://aistudio.google.com/apikey.
# Server-side only — never expose to the client. GEMINI_API_KEY /
# GOOGLE_API_KEY also work as aliases.
# LLM_API_KEY=
# Optional overrides: LLM_MODEL (default gemini-3.8-flash),
# LLM_CHUNK_SIZE — transactions per AI request (default 100).
